# Build output. src-tauri/target is 17 GB on this machine, and node_modules is
# 257 MB; without these two lines the first `git push` is unusable. This file
# did not exist at all until a Windows build needed a CI runner to clone the
# repo, which is not something you discover at the moment you need it.
src-tauri/target/
target/
node_modules/
dist/
dist-ssr/

# Frontend / tooling caches
.vite/
coverage/
*.tsbuildinfo

# Local tracker metadata; bookkeeping, not source.
.tracker-ids-written.json

# Real databases and their WAL sidecars. The app creates these next to the
# binary; they contain the user's own manifests and must never be committed.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local environment overrides
.env
.env.local
.env.*.local

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Hyperframes snapshot / preview artifacts inside brag compositions
brag-output/composition/snapshots/
brag-output/composition-vertical/snapshots/
brag-output/**/frames/

# Docs
docs/WorkspaceClone_Tracking.xlsx
docs/PRODUCT_GROWTH_PLAN.md

# Personal/session-specific spreadsheet maintenance scripts.
/scripts/create_tracking.py
/scripts/fix_tracker_bug022.py
/scripts/update_tracker.py
/scripts/update_tracker_session*.py